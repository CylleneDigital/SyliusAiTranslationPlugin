# Loaded by the sylius/test-application bootstrap (web, console and phpunit).
# Generic value: point it at your own database from .env.dev.local / .env.test.local (gitignored).
DATABASE_URL=mysql://root@127.0.0.1/cyllene_digital_sylius_ai_translation_plugin_%kernel.environment%

MESSENGER_TRANSPORT_DSN="doctrine://default"

# Where the @javascript Behat scenarios reach the test application, served in the test environment.
BEHAT_BASE_URL="http://127.0.0.1:8080/"

# Dummy keys by default: the back office works without real ones (generation fails cleanly).
# A real provider of your own: config/local.yaml (see local.yaml.dist), its key in .env.dev.local.
DEEPL_API_KEY=dummy:fx
LLM_API_KEY=dummy

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@CylleneDigitalSyliusAiTranslationPlugin/tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@CylleneDigitalSyliusAiTranslationPlugin/tests/TestApplication/config/routes.yaml"
