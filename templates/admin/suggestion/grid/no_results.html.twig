{% set resources = hookable_metadata.context.resources|default(null) %}

{% if resources.data is defined and resources.data|length == 0 %}
    <div class="card">
        <div class="empty">
            <div class="empty-icon">
                {{ ux_icon('tabler:check', {class: 'icon icon-lg text-success'}) }}
            </div>
            <p class="empty-title">{{ 'cyllene_digital_sylius_ai_translation.ui.no_pending_suggestions'|trans }}</p>
            <p class="empty-subtitle text-secondary">
                {# Only a filter that narrows the list is worth adjusting: the form sent with every field on "All" is not,
                   nor is a language of the generation form alone - nothing waits for that language, which a generation answers. #}
                {% if hookable_metadata.context.filtered|default(false) and not hookable_metadata.context.filtered_by_target_locale_only|default(false) %}
                    {{ 'sylius.ui.no_results_adjust_your_search'|trans }}
                {# The generation form is above only for who may generate, and when a provider is configured. #}
                {% elseif is_granted('cyllene_digital_sylius_ai_translation.generate') and hookable_metadata.context.available_providers|default([]) is not empty %}
                    {{ 'cyllene_digital_sylius_ai_translation.ui.no_pending_suggestions_hint'|trans }}
                {% else %}
                    {{ 'cyllene_digital_sylius_ai_translation.ui.no_pending_suggestions_nothing_to_review'|trans }}
                {% endif %}
            </p>
        </div>
    </div>
{% endif %}
