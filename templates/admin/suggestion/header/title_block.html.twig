{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}

{% set scope_params = hookable_metadata.context.scope_params %}

<div class="row mt-3 row-gap-2">
    <div class="col-12 col-md">
        <div class="d-md-flex gap-2 align-items-center">
            {{ header.h1('cyllene_digital_sylius_ai_translation.ui.ai_suggestions'|trans, 'tabler:sparkles', 'cyllene_digital_sylius_ai_translation.ui.ai_suggestions_description'|trans) }}
        </div>
    </div>
    <div class="col-12 col-md-auto ms-auto d-print-none">
        <div class="btn-list">
            <a href="{{ path('cyllene_digital_sylius_ai_translation_admin_translation_index', scope_params) }}" class="btn">
                {{ ux_icon('tabler:language') }}
                {{ 'cyllene_digital_sylius_ai_translation.ui.back_to_translations'|trans }}
            </a>
        </div>
    </div>
</div>
