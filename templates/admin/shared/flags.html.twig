{# Mirrors Sylius 1.x's @SyliusUi/Macro/flags.html.twig with the Sylius 2 rendering:
   the flagpack icon set through ux_icon, as the admin's country grid does. A locale
   without a region ("fr") renders nothing — the code alone is still displayed.
   `spacing`: the gap before the text — pass '' inside a flex container that already
   spaces its children (a Tabler .badge has its own gap). #}
{% macro fromLocaleCode(locale_code, spacing = 'me-2') %}
    {%- set country_code = locale_code|sylius_locale_country -%}
    {%- if country_code -%}
        {#- Flagpack icons have a 4:3 viewBox: override the 1em width/height default from ux_icons.yaml.
           No .flag class: it targets Tabler's CSS background flags. -#}
        {{ ux_icon('flagpack:' ~ country_code|lower, {'class': (spacing ~ ' flex-shrink-0 cyllene-translation-flag')|trim, 'width': '1.34em', 'height': '1em'}) }}
    {%- endif -%}
{% endmacro %}

{# "[fr_FR] Français (France)" — the bracketed code plus the Intl name, localised in
   the admin's language by sylius_locale_name. Text-only: usable inside <option>. #}
{% macro name(locale_code) %}
    {%- set locale_name = locale_code|sylius_locale_name -%}
    [{{ locale_code }}] {{ locale_name|slice(0, 1)|upper ~ locale_name|slice(1) }}
{%- endmacro %}

{# Flag + "[code] Name" — the full display everywhere HTML is allowed. #}
{% macro label(locale_code, spacing = 'me-2') %}
    {%- import _self as flags -%}
    {{ flags.fromLocaleCode(locale_code, spacing) }}{{ flags.name(locale_code) }}
{% endmacro %}
