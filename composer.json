{
    "name": "cyllene-digital/sylius-ai-translation-plugin",
    "type": "sylius-plugin",
    "description": "AI-assisted translation management for the Sylius 2 admin: browse every translation catalogue, override any wording per channel without touching the files, and review AI suggestions (OpenAI-compatible, Anthropic, DeepL) before they go live.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "translation",
        "i18n",
        "ai",
        "deepl",
        "openai",
        "anthropic",
        "localization",
        "llm",
        "ecommerce",
        "symfony"
    ],
    "license": "MIT",
    "homepage": "https://github.com/CylleneDigital/SyliusAiTranslationPlugin",
    "authors": [
        {
            "name": "Cyllene",
            "homepage": "https://github.com/CylleneDigital"
        }
    ],
    "support": {
        "issues": "https://github.com/CylleneDigital/SyliusAiTranslationPlugin/issues",
        "source": "https://github.com/CylleneDigital/SyliusAiTranslationPlugin",
        "security": "https://github.com/CylleneDigital/SyliusAiTranslationPlugin/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "cyllene-digital/ai-translation-bundle": "^2.0",
        "doctrine/persistence": "^3.1 || ^4.0",
        "pagerfanta/core": "^3.7 || ^4.0",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "sylius/sylius": "^2.1",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/doctrine-bridge": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.4 || ^8.0",
        "symfony/serializer": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/translation-contracts": "^3.5",
        "symfony/validator": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "behat/behat": "^3.22 || ^4.0",
        "behat/mink": "^1.11",
        "behat/mink-browserkit-driver": "^2.2",
        "dbrekelmans/bdi": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7 || ^3.0@alpha",
        "friends-of-behat/page-object-extension": "^0.4",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^1.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^12.2",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2",
        "sylius/test-application": "~2.1.0@alpha || ~2.2.0@alpha || ~2.3.0@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/runtime": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "symfony": {
            "require": "^7.4 || ^8.0"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "CylleneDigital\\SyliusAiTranslationPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\CylleneDigital\\SyliusAiTranslationPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migrations:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install vendor/sylius/test-application/public"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    }
}
